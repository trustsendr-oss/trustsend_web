{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "reemite.com" }],
      "destination": "https://www.reemite.com/$1",
      "permanent": true
    },
    {
      "source": "/login",
      "has": [{ "type": "host", "value": "www.reemite.com" }],
      "destination": "https://business.reemite.com/login",
      "permanent": false
    },
    {
      "source": "/login",
      "has": [{ "type": "host", "value": "www.trustsend.africa" }],
      "destination": "https://business.trustsend.africa/login",
      "permanent": false
    },
    {
      "source": "/signup",
      "has": [{ "type": "host", "value": "www.reemite.com" }],
      "destination": "https://business.reemite.com/signup",
      "permanent": false
    },
    {
      "source": "/signup",
      "has": [{ "type": "host", "value": "www.trustsend.africa" }],
      "destination": "https://business.trustsend.africa/signup",
      "permanent": false
    },
    {
      "source": "/dashboard/:path*",
      "has": [{ "type": "host", "value": "www.reemite.com" }],
      "destination": "https://business.reemite.com/dashboard/:path*",
      "permanent": false
    },
    {
      "source": "/dashboard/:path*",
      "has": [{ "type": "host", "value": "www.trustsend.africa" }],
      "destination": "https://business.trustsend.africa/dashboard/:path*",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.trustsend.africa" }],
      "destination": "https://www.reemite.com/$1",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "business.reemite.com" }],
      "destination": "/dashboard",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "business.trustsend.africa" }],
      "destination": "/dashboard",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "sandbox.reemite.com" }],
      "destination": "/dashboard",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "sandbox.trustsend.africa" }],
      "destination": "/dashboard",
      "permanent": false
    },
    {
      "source": "/:path(pricing|agents|transferts-internationaux|cartes-virtuelles|cryptomonnaies|paiement-marchand)",
      "has": [{ "type": "host", "value": "sandbox.reemite.com" }],
      "destination": "https://www.reemite.com/:path",
      "permanent": false
    },
    {
      "source": "/:path(pricing|agents|transferts-internationaux|cartes-virtuelles|cryptomonnaies|paiement-marchand)",
      "has": [{ "type": "host", "value": "sandbox.trustsend.africa" }],
      "destination": "https://www.reemite.com/:path",
      "permanent": false
    },
    {
      "source": "/:path(pricing|agents|transferts-internationaux|cartes-virtuelles|cryptomonnaies|paiement-marchand)",
      "has": [{ "type": "host", "value": "business.reemite.com" }],
      "destination": "https://www.reemite.com/:path",
      "permanent": false
    },
    {
      "source": "/:path(pricing|agents|transferts-internationaux|cartes-virtuelles|cryptomonnaies|paiement-marchand)",
      "has": [{ "type": "host", "value": "business.trustsend.africa" }],
      "destination": "https://www.reemite.com/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/app-shell"
    }
  ],
  "headers": [
    {
      "source": "/assets/:file(.+\\.(?:js|css|woff2))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "business.reemite.com" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "business.trustsend.africa" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "sandbox.reemite.com" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "sandbox.trustsend.africa" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
